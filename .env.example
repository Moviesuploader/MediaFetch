BOT_TOKEN=
DOWNLOAD_DIR=/tmp/mediafetch
# Role-based download limits. Admin/owner are unlimited at the MediaFetch layer.
FREE_MAX_FILE_MB=100
BRONZE_MAX_FILE_MB=500
PLATINUM_MAX_FILE_MB=1024
DIAMOND_MAX_FILE_MB=2048
ADMIN_MAX_FILE_MB=0
MAX_FILE_MB=50
MAX_CONCURRENT_DOWNLOADS=1

# Telegram MTProto large-file uploader. Keep all three values secret/configured
# only in Koyeb environment variables. USER_SESSION_STRING is never committed.
API_ID=
API_HASH=
USER_SESSION_STRING=
MTPROTO_UPLOAD_ENABLED=true
MTPROTO_NONPREMIUM_MAX_MB=2000
MTPROTO_PREMIUM_MAX_MB=4000
LARGE_UPLOAD_SPLIT_MB=2000
LOCAL_BOT_API_MAX_UPLOAD_MB=2000

# Optional persistence. Leave empty to use an in-memory fallback.
MONGODB_URI=
MONGODB_DB=mediafetch

# Comma-separated Telegram numeric user IDs with admin access.
ADMIN_IDS=

# Per-user daily successful download limits.
FREE_DAILY_LIMIT=10
PREMIUM_DAILY_LIMIT=100
BRONZE_DAILY_LIMIT=100
PLATINUM_DAILY_LIMIT=100
DIAMOND_DAILY_LIMIT=100

# Legacy global fallback; role limits above are used by the downloader.

# Cache lifetime for Telegram file_id results.
CACHE_TTL_DAYS=7

# Maximum carousel/photo items handled from one post.
MAX_CAROUSEL_ITEMS=10

# Koyeb: set WEBHOOK_MODE=true; KOYEB_PUBLIC_DOMAIN is detected automatically.
# Antideploy: set WEBHOOK_MODE=true and ANTIDEPLOY_PUBLIC_URL to the app's HTTPS URL.
WEBHOOK_MODE=false
WEBHOOK_SECRET=

# YouTube/general cookie jar.
YTDLP_COOKIES_FILE=/tmp/mediafetch-cookies.txt
# Optional: base64-encoded Netscape/Mozilla cookies.txt for ephemeral Koyeb instances.
# Keep this secret; never commit the value to GitHub or paste it into chat.
YTDLP_COOKIES_B64=

# Instagram gets a separate cookie jar so YouTube cookies are never sent to Instagram.
YTDLP_INSTAGRAM_COOKIES_FILE=/tmp/mediafetch-instagram-cookies.txt
# Optional: base64-encoded Netscape/Mozilla cookies.txt exported from the Instagram
# browser session. Only needed for content that requires an authenticated session.
YTDLP_INSTAGRAM_COOKIES_B64=\n\n# Optional proxy for Threads only. Useful when Meta rate-limits cloud-host IPs.\n# Keep credentials secret. Example: http://user:pass@host:port\nTHREADS_PROXY_URL=\n
# Facebook gets its own cookie jar for share/post URLs that Facebook exposes
# only to an authenticated browser session.
YTDLP_FACEBOOK_COOKIES_FILE=/tmp/mediafetch-facebook-cookies.txt
# Optional: base64-encoded Netscape/Mozilla cookies.txt exported from Facebook.
# Keep this secret and never commit the actual value.
YTDLP_FACEBOOK_COOKIES_B64=

# Platforms allowed to use the general cookie jar.
YTDLP_COOKIE_PLATFORMS=youtube
YTDLP_MAX_RETRIES=1
EXTRACTION_TIMEOUT_SECONDS=30
YOUTUBE_PROFILE_TIMEOUT_SECONDS=12

# Local bgutil PO-token provider for YouTube bot-check protection.
# MediaFetch starts the provider inside the same Koyeb container.
YOUTUBE_POT_PROVIDER_ENABLED=true
YOUTUBE_POT_PROVIDER_URL=http://127.0.0.1:4416
DOWNLOAD_TIMEOUT_SECONDS=900
PUBLIC_BASE_URL=
ANTIDEPLOY_PUBLIC_URL=


# Optional Local Bot API Server. Required for Telegram uploads above 50 MB.
# Example: http://telegram-bot-api.internal:8081
TELEGRAM_API_BASE_URL=
# Optional separate file endpoint, usually: http://telegram-bot-api.internal:8081
TELEGRAM_API_FILE_BASE_URL=


# Gateway-less manual UPI payments (no payment gateway)
PAYMENT_UPI_ID=2001aashish@yescred
PAYMENT_CURRENCY=INR
BRONZE_PRICE=49
PLATINUM_PRICE=99
DIAMOND_PRICE=149
PAYMENT_DURATION_DAYS=30
PAYMENT_QR_URL=
