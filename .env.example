BOT_TOKEN=
DOWNLOAD_DIR=/tmp/mediafetch
# Role-based source/upload policy. Admin can use up to 2000 MB once a Local
# Bot API Server is configured. Free users: 100 MB. Premium: 500 MB.
FREE_MAX_FILE_MB=100
PREMIUM_MAX_FILE_MB=500
ADMIN_MAX_FILE_MB=2000
MAX_FILE_MB=50
MAX_CONCURRENT_DOWNLOADS=1

# Optional persistence. Leave empty to use an in-memory fallback.
MONGODB_URI=
MONGODB_DB=mediafetch

# Comma-separated Telegram numeric user IDs with admin access.
ADMIN_IDS=

# Per-user daily successful download limits.
FREE_DAILY_LIMIT=10
PREMIUM_DAILY_LIMIT=100

# Legacy global fallback; role limits above are used by the downloader.

# Cache lifetime for Telegram file_id results.
CACHE_TTL_DAYS=7

# Maximum carousel/photo items handled from one post.
MAX_CAROUSEL_ITEMS=10

# Koyeb: set WEBHOOK_MODE=true; KOYEB_PUBLIC_DOMAIN is detected automatically.
# Antideploy: set WEBHOOK_MODE=true and ANTIDEPLOY_PUBLIC_URL to the app's HTTPS URL.
WEBHOOK_MODE=false
WEBHOOK_SECRET=

# YouTube/general cookie jar.
YTDLP_COOKIES_FILE=/tmp/mediafetch-cookies.txt
# Optional: base64-encoded Netscape/Mozilla cookies.txt for ephemeral Koyeb instances.
# Keep this secret; never commit the value to GitHub or paste it into chat.
YTDLP_COOKIES_B64=

# Instagram gets a separate cookie jar so YouTube cookies are never sent to Instagram.
YTDLP_INSTAGRAM_COOKIES_FILE=/tmp/mediafetch-instagram-cookies.txt
# Optional: base64-encoded Netscape/Mozilla cookies.txt exported from the Instagram
# browser session. Only needed for content that requires an authenticated session.
YTDLP_INSTAGRAM_COOKIES_B64=

# Platforms allowed to use the general cookie jar.
YTDLP_COOKIE_PLATFORMS=youtube
YTDLP_MAX_RETRIES=2
EXTRACTION_TIMEOUT_SECONDS=60
DOWNLOAD_TIMEOUT_SECONDS=900
PUBLIC_BASE_URL=
ANTIDEPLOY_PUBLIC_URL=


# Optional Local Bot API Server. Required for Telegram uploads above 50 MB.
# Example: http://telegram-bot-api.internal:8081
TELEGRAM_API_BASE_URL=
# Optional separate file endpoint, usually: http://telegram-bot-api.internal:8081
TELEGRAM_API_FILE_BASE_URL=
